# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB (optimized for 3000+ users with connection pooling)
MONGODB_URI=mongodb://localhost:27017/bharatfundedtrade

# Redis (optional - for scaling to 3000+ users)
# Install Redis: brew install redis (Mac) or apt install redis-server (Linux)
# Start Redis: redis-server
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-strong-secret-key-here
JWT_EXPIRES_IN=7d

# Google Sign-In (Continue with Google)
# REQUIRED for /api/auth/google — without it the endpoint returns 503
# "Google login is not configured on this server".
# MUST be the SAME OAuth 2.0 Web client id as the client's VITE_GOOGLE_CLIENT_ID
# (the server checks the ID token's `aud` equals this). Create it at
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web),
# and add https://dhanfunded.com to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# SMTP (Hostinger / Nodemailer) — signup email OTP + forgot password
# Hostinger: smtp.hostinger.com
# — Port 465: SMTP_SECURE=true (implicit SSL)
# — Port 587: SMTP_SECURE=false (STARTTLS) — wrong secure flag is the #1 connection failure
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password
# Debug SMTP in server logs: SMTP_DEBUG=true
# Optional: override From (defaults to SMTP_USER)
# SMTP_FROM=you@yourdomain.com
# SMTP_FROM_NAME=DhanFunded
# Set to false to disable signup OTP even when SMTP is set (not recommended prod)
# REQUIRE_SIGNUP_OTP=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin
ADMIN_DEFAULT_PASSWORD=change-this-admin-password

# MetaAPI Configuration (server-side proxy - keeps token secure)
METAAPI_ACCOUNT_ID=your-metaapi-account-id
METAAPI_AUTH_TOKEN=your-metaapi-auth-token
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai
METAAPI_MARKET_DATA_URL=https://mt-market-data-client-api-v1.london.agiliumtrade.ai
# Optional: {"XAUUSD":["GOLD","XAUUSD.i"]} — extra MT symbol names for historical charts
# METAAPI_CHART_SYMBOL_ALIASES=

# ── Razorpay payment gateway (challenge purchase) ──
# Get these from Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set this same secret in Razorpay Dashboard → Webhooks when adding the webhook
# URL:  https://api.dhanfunded.com/api/prop/razorpay/webhook
# Subscribe to events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Cashfree payment gateway (challenge purchase) ──
# Get these from Cashfree Dashboard → Developers → API Keys.
# CASHFREE_ENV: 'production' for live keys (cfsk_ma_prod_...), 'sandbox' for test.
# Webhook URL to add in Cashfree Dashboard → Developers → Webhooks:
#   https://api.dhanfunded.com/api/prop/cashfree/webhook
# The webhook signature is verified with CASHFREE_SECRET_KEY (no separate secret).
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=production
